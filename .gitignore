# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# go
/apps/api/.gocache
/apps/api/.gotmp
/apps/api/sync
/apps/api/server

# build output uploaded to OSS
/apps/web/dist

# pnpm store created by local runs
/.pnpm-store

# image pipeline scratch dirs
/.images-tmp
/.images-cache
.kiro/settings/mcp.json
